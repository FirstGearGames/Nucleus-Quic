<Project Sdk="Microsoft.NET.Sdk">

    <!--
        Live tests for the WebTransport transport: real CoreManagers over real QUIC on loopback, through MsQuic. On Windows the runtime's
        own msquic.dll is found beside the shared framework; on Linux libmsquic must be installed. Run in Release.
    -->
    <PropertyGroup>
        <TargetFramework>net9.0</TargetFramework>
        <ImplicitUsings>disable</ImplicitUsings>
        <Nullable>enable</Nullable>
        <IsPackable>false</IsPackable>
        <IsTestProject>true</IsTestProject>
        <NucleusAssembliesDirectory Condition="'$(NucleusAssembliesDirectory)' == ''">D:\Development\Nucleus\Unity Integration\Nucleus - Unity Integration\Assets\Nucleus</NucleusAssembliesDirectory>
    </PropertyGroup>

    <ItemGroup>
        <PackageReference Include="Microsoft.NET.Test.Sdk" Version="17.12.0" />
        <PackageReference Include="xunit" Version="2.9.2" />
        <PackageReference Include="xunit.runner.visualstudio" Version="2.8.2" />
    </ItemGroup>

    <ItemGroup>
        <ProjectReference Include="..\Build\Nucleus.Integrations.Unity.Quic.csproj" />
        <Reference Include="Nucleus" HintPath="$(NucleusAssembliesDirectory)\Nucleus.dll" />
        <Reference Include="CodeBoost" HintPath="$(NucleusAssembliesDirectory)\CodeBoost.dll" />
        <Analyzer Include="$(NucleusAssembliesDirectory)\Nucleus.CodeAnalysis.SourceGenerators.dll" />
    </ItemGroup>

</Project>
